# Server
PORT=8080
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_HOURS=72

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_manager

# Redis (rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass
RATE_LIMIT=100        # requests per minute per IP

# Optional
LOG_LEVEL=info / warn / error
